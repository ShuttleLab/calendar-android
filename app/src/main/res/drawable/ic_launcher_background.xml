<?xml version="1.0" encoding="utf-8"?>
<!--
  背景:靛蓝 → 紫罗兰的对角渐变,取自 ui/theme/Theme.kt 的同一组色阶(Tailwind
  indigo-600 → violet-600),所以图标与界面是同一个色系,也与同属 ShuttleLab 的其他应用
  认得出是一家。
  EN: a diagonal indigo → violet gradient from the same ramp as Theme.kt (Tailwind indigo-600 →
  violet-600), so the icon and the UI share one palette — and read as part of the same family as
  ShuttleLab's other apps.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#4F46E5"
                android:endColor="#7C3AED" />
        </aapt:attr>
    </path>
</vector>
